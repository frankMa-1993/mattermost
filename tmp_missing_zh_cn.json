    "key": "admin.mobileSecurity.ephemeralMode_feature_discovery.description",
    "val": "With Mattermost Enterprise Advanced, you can enable Mobile Ephemeral Mode to enforce data persistence policies on mobile devices. Configure disconnection timeouts, offline data retention, and automatic cache cleanup."
  },
  {
    "key": "admin.mobileSecurity.ephemeralMode_feature_discovery.title",
    "val": "Control mobile data persistence with Mobile Ephemeral Mode"
  },
  {
    "key": "admin.mobileSecurity.ephemeralMode.autoCacheCleanup.placeholder",
    "val": "E.g.: 7"
  },
  {
    "key": "admin.mobileSecurity.ephemeralMode.autoCacheCleanup.range",
    "val": "Must be a number between 0 and 60 days."
  },
  {
    "key": "admin.mobileSecurity.ephemeralMode.autoCacheCleanupDescription",
    "val": "Controls the maximum age of any content cached on the device, regardless of connection status. Prevents unbounded accumulation of sensitive data. Set to 0 for zero-persistence mode where content is never persisted to disk."
  },
  {
    "key": "admin.mobileSecurity.ephemeralMode.autoCacheCleanupTitle",
    "val": "Auto Cache Cleanup (days):"
  },
  {
    "key": "admin.mobileSecurity.ephemeralMode.banner",
    "val": "Changes to these settings are delivered to connected devices in real time. Offline devices will continue operating under their last-known settings until they re-establish a server connection. Timer state persists across app and device restarts."
  },
  {
    "key": "admin.mobileSecurity.ephemeralMode.disconnectionTimeout.placeholder",
    "val": "E.g.: 60"
  },
  {
    "key": "admin.mobileSecurity.ephemeralMode.disconnectionTimeout.range",
    "val": "Must be a number between 0 and 600 seconds (10 minutes)."
  },
  {
    "key": "admin.mobileSecurity.ephemeralMode.disconnectionTimeoutDescription",
    "val": "Grace period after losing server connection before the device is considered offline. Helps avoid false triggers from brief network interruptions. Values below 5 are not recommended."
  },
  {
    "key": "admin.mobileSecurity.ephemeralMode.disconnectionTimeoutTitle",
    "val": "Disconnection Timeout (seconds):"
  },
  {
    "key": "admin.mobileSecurity.ephemeralMode.enableDescription",
    "val": "When enabled, mobile clients will follow the server-configured ephemeral data policies. Disconnected devices will clean up cached data based on the configured timers."
  },
  {
    "key": "admin.mobileSecurity.ephemeralMode.enableTitle",
    "val": "Enable Mobile Ephemeral Mode:"
  },
  {
    "key": "admin.mobileSecurity.ephemeralMode.offlinePersistence.disabled",
    "val": "How long cached content is kept after the device goes offline. When the timer expires, cached content is deleted but session credentials are preserved. Set to 0 for immediate cleanup. Requires Mobile Ephemeral Mode to be enabled and Auto Cache Cleanup to be greater than 0."
  },
  {
    "key": "admin.mobileSecurity.ephemeralMode.offlinePersistence.placeholder",
    "val": "E.g.: 24"
  },
  {
    "key": "admin.mobileSecurity.ephemeralMode.offlinePersistence.range",
    "val": "Must be a number between 0 and 72 hours (3 days)."
  },
  {
    "key": "admin.mobileSecurity.ephemeralMode.offlinePersistenceDescription",
